# Copy to .env (never commit .env).
# Provider: ollama (default, free, local) or anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434

# For LLM_PROVIDER=anthropic (the SDK also accepts an `ant auth login` profile)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Gemini (free tier data may be used by Google to improve products; opt-in per request)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
