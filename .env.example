# Copy to .env (never commit .env). `npm run serve` and the eval scripts load it automatically.

# --- smart server ---
# PORT=8788
# HOST=127.0.0.1
# The remote-terminal-access engine behind the /engine proxy
# ENGINE_URL=http://127.0.0.1:8787
# Extra browser origins allowed to call this server (its own origin is always allowed)
# ALLOWED_ORIGINS=

# --- provider ---
# Default provider: ollama (free, local), gemini or anthropic (cloud, ask for consent per request)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434

# Gemini: on the free tier Google may use prompts to improve its products and reviewers may read them
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (the SDK also accepts an `ant auth login` profile)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
